# Base de données PostgreSQL. Laisser vide en développement : une base
# embarquée (PGlite) est alors créée dans .data/pglite. Obligatoire en production
# (Neon, Supabase, Vercel Postgres… : toute URL postgres:// fonctionne).
DATABASE_URL=

# Envoi des liens de connexion par e-mail (resend.com). Laisser vide en
# développement : le lien s'affiche alors à l'écran et dans le terminal.
# Obligatoire en production.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Valyo <onboarding@resend.dev>"

# Adresses e-mail des administrateurs, séparées par des virgules. Elles donnent
# accès à /admin/indicateurs après connexion.
ADMIN_EMAILS=

# Adresse publique du site (ex. https://valyo.example). Obligatoire en production :
# c'est la seule origine acceptée pour les écritures, et la base des liens envoyés
# par e-mail. Sans elle en production, toutes les écritures sont refusées.
# Facultative en développement.
APP_URL=

# Limites de fréquence (decisions.md §4.6). Facultatif : valeurs par défaut indiquées.
# LIMIT_LOGIN_LINKS_PER_HOUR=5
# LIMIT_POSTS_PER_HOUR=10
# LIMIT_COMMENTS_PER_HOUR=60

# Clé de l'API Claude pour l'agent éditorial (lot 2B). À renseigner uniquement dans
# .env.local (jamais committé), jamais dans le code, le journal ou une discussion.
ANTHROPIC_API_KEY=

# Agent éditorial : worker lancé par `npm run worker`. Avec « fixtures », il lit
# tests/fixtures/editorial/web au lieu du réseau (démonstration locale uniquement).
# EDITORIAL_TRANSPORT=fixtures

# Tests de bout en bout uniquement : ouvre /api/test-hooks (changement de statut
# d'un compte). Ignoré en production. Ne jamais l'activer ailleurs que sur une base de test.
# VALYO_TEST_HOOKS=1

# Synthèses IA des articles (quotas SEC-03, tous facultatifs — défauts entre parenthèses) :
# VALYO_SYNTHESES_PAR_JOUR : tentatives quotidiennes à la demande des membres (150)
# VALYO_SYNTHESES_AUTO_PAR_JOUR : tentatives quotidiennes à l'import automatique (300)
# VALYO_SYNTHESES_BUDGET_JOUR : budget quotidien en devise, coût réel des réponses (2)
# VALYO_SYNTHESE_MODELE : modèle Claude utilisé (claude-haiku-5-5)
# VALYO_SYNTHESE_AUTO : 0 pour couper la synthèse automatique à l'import
