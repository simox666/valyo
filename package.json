{
  "name": "valyo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:acceptance": "node --test tests/acceptance/*.test.ts",
    "test:acceptance:http": "node tests/acceptance/codex-chat-reproduction.mjs && node --test tests/acceptance/*.http.mjs",
    "test:e2e": "node tests/e2e-smoke.mjs",
    "worker": "tsx --conditions=react-server scripts/worker.mts",
    "essai": "tsx --conditions=react-server scripts/essai.mts",
    "recette:concurrence": "tsx --conditions=react-server scripts/recette-concurrence.mts",
    "charge": "node scripts/charge.mjs",
    "test:acceptance:production": "node tests/acceptance/codex-appeal-production.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "fast-xml-parser": "^5.12.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
