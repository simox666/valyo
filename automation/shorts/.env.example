# Copie ce fichier en « .env » (même dossier) et remplis la valeur du jeton.
# Le fichier .env n'est jamais envoyé sur GitHub.

# Adresse du site Valyo.
VALYO_URL=https://www.valyo.si

# Jeton partagé avec le site (variable VALYO_SHORTS_TOKEN sur Railway). C'est le seul secret de l'automate :
# les clés d'IA et de voix restent sur le serveur.
VALYO_SHORTS_TOKEN=
